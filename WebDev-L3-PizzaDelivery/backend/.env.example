PORT=5000
MONGO_URI=mongodb+srv://xxxx_db_user:<db_password>@cluster.xxxxx.mongodb.net/pizza_delivery?appName=Cluster
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Email (use a Gmail App Password or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

# Razorpay TEST keys (from Razorpay Dashboard -> Test Mode -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxx

# Low stock threshold (units)
LOW_STOCK_THRESHOLD=20
